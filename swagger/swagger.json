{
    "openapi": "3.0.0",
    "info": {
        "title": "Student Management System",
        "version": "1.0.0",
        "description": "A simple system, where you can insert, update, delete student's detail."
    },
    "servers": [
        {
            "url": "http://localhost:3000"
        }
    ],
    "paths": {
        "/insert": {
            "post": {
                "summary": "Insert a new student",
                "description": "Inserts a new student record with student data and an Adhaar image",
                "tags": [
                    "Insert"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "Enroll": {
                                        "type": "integer",
                                        "description": "Enrollment number of the student"
                                    },
                                    "Name": {
                                        "type": "string",
                                        "description": "Name of the student"
                                    },
                                    "Email": {
                                        "type": "string",
                                        "format": "email",
                                        "description": "Email address of the student"
                                    },
                                    "Course": {
                                        "type": "string",
                                        "description": "Enrolled course of the student"
                                    },
                                    "Adhaar": {
                                        "type": "string",
                                        "format": "binary",
                                        "description": "Adhaar image of the student"
                                    }
                                },
                                "required": [
                                    "Enroll",
                                    "Name",
                                    "Email",
                                    "Course",
                                    "Adhaar"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Student created successfully"
                    },
                    "404": {
                        "description": "Not found"
                    }
                }
            }
        },
        "/delete/{id}": {
            "get": {
                "summary": "Delete a student",
                "description": "Deletes a perticuler student record",
                "tags": [
                    "Delete"
                ],
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "required": "true",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Student deleted successfully"
                    },
                    "404": {
                        "description": "Not found"
                    }
                }
            }
        },
        "/update": {
            "post": {
                "summary": "Update student record by enrollment number",
                "description": "Update student record by enrollment number",
                "tags": [
                    "Update"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "Enroll": {
                                        "type": "integer",
                                        "description": "Enrollment number of the student"
                                    },
                                    "Name": {
                                        "type": "string",
                                        "description": "Name of the student"
                                    },
                                    "Email": {
                                        "type": "string",
                                        "format": "email",
                                        "description": "Email address of the student"
                                    },
                                    "Course": {
                                        "type": "string",
                                        "description": "Enrolled course of the student"
                                    },
                                    "Adhaar": {
                                        "type": "string",
                                        "format": "binary",
                                        "description": "Adhaar image of the student"
                                    }
                                },
                                "required": [
                                    "Enroll",
                                    "Name",
                                    "Email",
                                    "Course",
                                    "Adhaar"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Student updated successfully"
                    },
                    "404": {
                        "description": "Not found"
                    }
                }
            }
        }
    }
}