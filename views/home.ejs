<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Required meta tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC"
      crossorigin="anonymous"
    />
    <link rel="shortcut icon" href="img/student.png" type="image/x-icon">
    <title>Home Page</title>
    <style>
      * {
        margin: 0;
        padding: 5px;
      }
      body {
        width: 100%;
      }
      .actionCell {
        display: flex;
        gap: 10px;
        justify-content: center;
      }
      /* table tr {
        text-align: center;
        justify-content: center;
      }
      .heading {
        text-align: center;
      }
      th {
        background-color: rgb(140, 13, 214);
        color: white;
        padding: 5px 15px;
      }
      td {
        padding: 5px 15px;
      } */
      /* .form-popup {
        display: none; */
      /* top: 0;
        background-color: rgb(42, 183, 226);
        color: black;
        margin: 0% 25%;
        padding: 5%;
        position: fixed;
        font-weight: bold;
        justify-items: center;
        align-content: center;
        border: 3px solid black;
        z-index: 9; */
      /* } */
    </style>
  </head>
  <body>
    <script>
      // function openForm() {
      //   document.getElementById("myForm").style.display = "block";
      // }
      // function closeForm() {
      //   document.getElementById("myForm").style.display = "none";
      // }
      function edit(btn) {
        // openForm();

        let student = JSON.parse(btn.getAttribute("data-student"));
        document.getElementById("Enroll").value = student.Enroll;
        document.getElementById("Name").value = student.Name;
        document.getElementById("Email").value = student.Email;
        document.getElementById("Course").value = student.Course;
        // document.getElementById("Adhaar").value = student.Adhaar;
        let AdhaarImgPath = `images/${student.Enroll}.jpeg`;
        document.getElementById("AdhaarImg").setAttribute("src", AdhaarImgPath);
        document.getElementById("AdhaarImg").setAttribute("height", "200px");
      }
      function onAddBtn() {
        // openForm();
        document.getElementById("Enroll").value = "";
        document.getElementById("Name").value = "";
        document.getElementById("Email").value = "";
        document.getElementById("Course").value = "";
        document.getElementById("AdhaarImg").setAttribute("hidden", "true");
        document
          .getElementById("AdhaarImgLabel")
          .setAttribute("hidden", "true");
      }
    </script>
    <h1 class="heading text-center">Students Data</h1>

    <button
      type="button"
      data-bs-toggle="modal"
      data-bs-target="#exampleModal"
      data-bs-whatever="@mdo"
      onclick="onAddBtn()"
      class="btn btn-primary"
    >
      ✍️ Add Student
    </button>
    <br /><br />
    <table
      class="table text-center table-bordered table-hover" 
      border="2px solid black"
      width="100%"
    >
      <thead>
        <th>Enroll</th>
        <th>Name</th>
        <th>Email</th>
        <th>Course</th>
        <th>Adhaar Upload</th>
        <th>Action</th>
      </thead>
      <tbody>
        <% students.forEach((student)=>{ %>
        <tr>
          <td><%= student.Enroll%></td>
          <td><%= student.Name%></td>
          <td><%= student.Email%></td>
          <td><%= student.Course%></td>
          <td>
            <img
              src="images/<%= student.Enroll%>.jpeg"
              height="200px"
              alt="Img Not available"
            />

            <!-- <a href="img/<%= student.Enroll%>.jpeg" target="_blank"
              >📄 Click here for Adhaar</a
            > -->
          </td>
          <td class="actionCell">
            <button
              type="button"
              data-student="<%= JSON.stringify(student) %>"
              onclick="edit(this)"
              data-bs-toggle="modal"
              data-bs-target="#exampleModal"
              data-bs-whatever="@mdo"
              class="updateBtn btn btn-primary"
            >
              📝 Edit
            </button>

            <form action="/delete/<%= student.Enroll%>" method="get">
              <button type="submit" class="deleteBtn btn btn-primary">
                ❌ Delete
              </button>
            </form>
          </td>
        </tr>
        <%});%>
      </tbody>
    </table>
    <br />

    <div
      class="modal fade"
      id="exampleModal"
      tabindex="-1"
      aria-labelledby="exampleModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="exampleModalLabel">Student Record Form</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body">
            <!-- <div id="myForm" class="form-popup"> -->
            <form enctype="multipart/form-data" action="/insert" method="post">
              <!-- <legend class="text-center">Student Record Form</legend> -->
              <div class="mb-3">
                <label class="form-label" for="Enroll"
                  >Enter your Enrollment No. :</label
                >
                <input
                  class="form-control"
                  type="number"
                  name="Enroll"
                  id="Enroll"
                />
              </div>
              <div class="mb-3">
                <label class="form-label" for="Name">Enter your Name :</label>
                <input class="form-control" type="text" name="Name" id="Name" />
              </div>
              <div class="mb-3">
                <label class="form-label" for="Email">Enter your Email :</label>
                <input
                  class="form-control"
                  type="email"
                  name="Email"
                  id="Email"
                />
              </div>
              <div class="mb-3">
                <label class="form-label" for="Course"
                  >Enter your Course :</label
                >
                <input
                  class="form-control"
                  type="text"
                  name="Course"
                  id="Course"
                />
              </div>
              <div class="mb-3">
                <label class="form-label" for="Adhaar"
                  >Upload Adhaar Card :</label
                >
                <input
                  class="form-control"
                  type="file"
                  name="Adhaar"
                  id="Adhaar"
                />
              </div>
              <div class="mb-3">
                <label class="form-label" id="AdhaarImgLabel" for="AdhaarImg"
                  >Current Img :</label
                ><br />
                <img id="AdhaarImg" alt="Image Not available" />
              </div>
              <div class="d-grid mb-3 gap-2">
                <input class="btn btn-primary" type="submit" value="Submit" />
              </div>
              <!-- <div class="d-grid gap-2">
                  <input
                    class="btn btn-primary"
                    type="button"
                    value="Close"
                    onclick="closeForm()"
                  />
                </div> -->

              <!-- <input type="submit" value="Submit" /> -->
            </form>
            <!-- </div> -->
          </div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-secondary"
              data-bs-dismiss="modal"
            >
              Close
            </button>
          </div>
        </div>
      </div>
    </div>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
